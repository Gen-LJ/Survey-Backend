# Copy to .env for local development. On a hosting platform, set these as
# environment variables instead; the app does not need the file to exist.

# --- required ---
DB_HOST=127.0.0.1
DB_USER=root
DB_NAME=test_db
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- admin bootstrap ---
# Creates the platform administrator on boot when the account does not exist.
# RegisterUser refuses the admin role, so without these the admin endpoints are
# unreachable. Safe to leave set: an existing account is never modified.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# --- optional, shown with their defaults ---
DB_PASSWORD=
DB_PORT=3306
PORT=8080

# development | production. Production turns on gin release mode and quiets
# GORM's slow-query logging.
APP_ENV=development

# Apply AutoMigrate on boot. Defaults to true in development and false in
# production, where it costs ~180 introspection queries per restart. Set it to
# true for the first production deploy (and after any schema change), then
# remove it.
# RUN_MIGRATIONS=true

# Set to true for hosted MySQL (TiDB Cloud, Aiven, ...), which requires TLS.
# Leave false for a local server that does not offer it.
DB_TLS=false

# Replaces the whole DSN query string when a provider needs something specific.
# DB_PARAMS=charset=utf8mb4&parseTime=True&loc=Local&tls=true

# Set to true if AutoMigrate fails on foreign keys (TiDB and some other
# MySQL-compatible engines). Child rows are deleted explicitly in Go, so the
# database-level cascades are redundant.
# DB_DISABLE_FK=true

# Managed MySQL plans cap concurrent connections; keep these under the plan's limit.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=15s

# silent | error | warn | info. Defaults to error in production, warn otherwise.
# DB_LOG_LEVEL=

# Only needed for a Flutter web build. Comma separated; empty disables CORS.
# CORS_ALLOWED_ORIGINS=https://your-app.example.com,http://localhost:3000
