{
  "info": {
    "name": "Survey Spark API",
    "description": "Go backend for Survey Spark. Run the Auth folder first, then Admin > Activate country.\n\nEach login stores its own token and the role folders pick the right one automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{interviewer_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://survey-backend-2934.onrender.com"
    },
    {
      "key": "admin_email",
      "value": ""
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "interviewer_email",
      "value": "iva@example.com"
    },
    {
      "key": "interviewer_password",
      "value": "pw123456"
    },
    {
      "key": "respondent_email",
      "value": "ray@example.com"
    },
    {
      "key": "respondent_password",
      "value": "pw123456"
    },
    {
      "key": "country_id",
      "value": "119"
    },
    {
      "key": "region_id",
      "value": "1"
    },
    {
      "key": "category_id",
      "value": "1"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "interviewer_token",
      "value": ""
    },
    {
      "key": "respondent_token",
      "value": ""
    },
    {
      "key": "survey_id",
      "value": ""
    },
    {
      "key": "question_id",
      "value": ""
    },
    {
      "key": "rating_question_id",
      "value": ""
    },
    {
      "key": "text_question_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 \u00b7 Setup",
      "description": "Run first, in order. A country must be active before registration works at all.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "No auth, touches no database. Render's health check path.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Seeded from ADMIN_EMAIL / ADMIN_PASSWORD on boot.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code < 300 && body.success) {",
                  "    pm.collectionVariables.set('admin_token', body.data.token);",
                  "    console.log('admin_token =', pm.collectionVariables.get('admin_token'));",
                  "}",
                  "pm.test('succeeded', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Activate country",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/country/toggle",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "country",
                "toggle"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{country_id}},\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Every country seeds inactive, so /auth/register-form 500s until one is activated."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2 \u00b7 Auth",
      "description": "Registration needs an active country from step 1. /auth/register-form is public and returns countries with their regions nested - everything the signup screen needs.",
