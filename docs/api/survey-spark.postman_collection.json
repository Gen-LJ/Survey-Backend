    {
      "name": "3 \u00b7 Admin",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{admin_token}}",
            "type": "string"
          }
        ]
      },
      "description": "Admin only. List countries to find an id, toggle one active, and grant points before publishing.",
      "item": [
        {
          "name": "List active countries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/country/list?active=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "country",
                "list"
              ],
              "query": [
                {
                  "key": "active",
                  "value": "true"
                }
              ]
            },
            "description": "Admin only. Which countries the platform currently accepts, without opening the database."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('ok', () => pm.response.to.have.status(200));",
                  "console.log('active countries:', b.data.map(c => c.id + ' ' + c.name).join(', '));"
                ]
              }
            }
          ]
        },
        {
          "name": "List all countries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/country/list",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "country",
                "list"
              ]
            },
            "description": "Every country with its active flag, name-sorted. Use this to find the id of one to activate. ?active=false narrows it to the inactive ones."
          },
          "response": []
        },
        {
          "name": "Grant points",
