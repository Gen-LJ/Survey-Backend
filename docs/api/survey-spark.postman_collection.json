          "name": "Register form",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/register-form",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register-form"
              ]
            },
            "description": "Active countries with their regions. Returns 500 while no country is active.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Register interviewer",
          "request": {
            "method": "POST",
            "header": [
